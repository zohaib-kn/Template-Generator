# Copy to .env.local and fill in. Never commit real values.

# --- Student CRM (server-side only; never prefix with NEXT_PUBLIC_) ---
SENIOR_API_BASE_URL=https://crm.digi-wire.com
SENIOR_API_KEY=
# Optional: full roster URL. Defaults to ${SENIOR_API_BASE_URL}/api/students?key=${SENIOR_API_KEY}
CRM_STUDENT_LIST_URL=

# Public link to the CRM student viewer (no credentials in this URL)
NEXT_PUBLIC_CRM_VIEWER_URL=https://crm.digi-wire.com/student-data-viewer

# --- Operator authentication (CRM token passthrough; see docs/crm-auth-contract.md) ---
# CRM endpoint that verifies operator tokens. Unset = nobody can sign in (fail closed).
CRM_AUTH_VERIFY_URL=
# Optional service credential this app sends to the verify endpoint as X-API-Key.
CRM_AUTH_SERVICE_KEY=
# Random string, at least 32 characters, used to sign session cookies. e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Local development only: skip sign-in. Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=false

# --- Webhooks (X-API-Key) ---
DOCUMENT_WEBHOOK_API_KEY=

# --- Data / AI ---
MONGODB_URI=
GEMINI_API_KEY=
